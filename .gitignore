# Create .gitignore
cat > .gitignore << 'EOF'
# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# local env files
.env
.env.local
.env.production
.env.development
.env*.local

# Build outputs
android/app/build/
android/.gradle/
android/build/
ios/Pods/
ios/build/

# IDE
.vscode/
.idea/

# Keystore files
android/app/*.keystore
android/app/debug.keystore
android/app/release.keystore

# Firebase config
google-services.json
GoogleService-Info.plist

# System files
.DS_Store
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# TypeScript
*.tsbuildinfo
expo-env.d.ts

# Metro
.metro-health-check*

# Generated folders
/ios
/android
EOF